# Database
DATABASE_URL=postgresql+asyncpg://adengine:change-me@localhost:5432/adengine

# Internal API key required on every protected endpoint (X-API-Key header)
API_KEY=change-me-to-a-long-random-string

# Meta Marketing API
META_API_VERSION=v23.0
# Each AdAccount row stores the NAME of an env var that holds its System User token,
# e.g. secret_ref=META_TOKEN_ACME. The token itself never lives in the database.
META_TOKEN_ACME=

# Google Ads API (developer token and OAuth client are shared; refresh token is per account via secret_ref)
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_CUSTOMER_ID=
GOOGLE_REFRESH_TOKEN_ACME=

# LLM used to generate variations of winning angles (human approval is still required)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optimization thresholds (defaults shown)
LOOKBACK_DAYS=7
KILL_CPA_MULTIPLE=2.0
KILL_MIN_HOOK_IMPRESSIONS=2000
KILL_MIN_HOOK_RATE_PCT=15.0
SCALE_STEP=0.15
SCALE_COOLDOWN_HOURS=72
SCALE_MIN_CONVERSION_DAYS=3
SCALE_CPA_STABILITY_CV=0.25
ITERATION_MIN_CONVERSIONS=20
ITERATION_ROAS_MULTIPLE=1.5
ITERATION_COOLDOWN_DAYS=7

# Create tables on startup. Dev only; use Alembic migrations in production.
AUTO_CREATE_SCHEMA=false
